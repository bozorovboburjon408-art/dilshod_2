{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": false, "skipLibCheck": true,
    "isolatedModules": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
